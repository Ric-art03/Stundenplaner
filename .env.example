# Supabase Configuration
# Kopiere diese Datei nach .env.local und trage deine echten Schluessel ein.
# Schluessel findest du unter: https://supabase.com/dashboard/project/_/settings/api

# Oeffentlich — wird im Browser sichtbar (das ist OK, RLS schuetzt die Daten)
NEXT_PUBLIC_SUPABASE_URL=https://dein-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dein-anon-key-hier

# Geheim — NUR auf dem Server verwenden, NIEMALS im Browser-Code!
SUPABASE_SERVICE_ROLE_KEY=dein-service-role-key-hier

# App URL (fuer Passwort-Reset und E-Mail-Verifizierung)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
